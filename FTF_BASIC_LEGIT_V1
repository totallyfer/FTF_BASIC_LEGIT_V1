	local function toAssetId(p2)
		if type(p2) == "number" and p2 > 0 then
			return "rbxassetid://" .. p2
		elseif type(p2) == "string" and p2 ~= "" and p2 ~= "0" then
			if string.find(p2, "rbxassetid://", 1, true) then
				return p2
			end
			return "rbxassetid://" .. p2
		end
		return nil
	end

	local function scanDescendantsYield(root, fn)
		local t0 = os.clock()
		local rIdx, wIdx = 1, 1
		local queue = {root}
		while rIdx <= wIdx do
			local cur = queue[rIdx]
			queue[rIdx] = nil
			rIdx = rIdx + 1
			if cur then
				local ch = cur:GetChildren()
				for i = 1, #ch do
					wIdx = wIdx + 1
					queue[wIdx] = ch[i]
					fn(ch[i])
				end
			end
			if os.clock() - t0 > 0.003 then
				task.wait()
				t0 = os.clock()
			end
		end
	end

	local function runChunkedList(list, fn, doneCb)
		local total = #list
		if total == 0 then
			if doneCb then doneCb() end
			return
		end
		task.spawn(function()
			local t0 = os.clock()
			for i = 1, total do
				if list[i] then fn(list[i]) end
				if os.clock() - t0 > 0.004 then
					task.wait()
					t0 = os.clock()
				end
			end
			if doneCb then doneCb() end
		end)
	end

	local function isCharacterDescendant(p9)
		local parent = p9.Parent
		if not parent then return false end
		local cached = modState.charCheckCache[parent]
		if cached ~= nil then return cached end
		if Players:GetPlayerFromCharacter(parent) then
			modState.charCheckCache[parent] = true
			return true
		end
		local p2 = parent.Parent
		if p2 then
			local cached2 = modState.charCheckCache[p2]
			if cached2 ~= nil then return cached2 end
			if Players:GetPlayerFromCharacter(p2) then
				modState.charCheckCache[p2] = true
				return true
			end
		end
		modState.charCheckCache[parent] = false
		return false
	end

	local function applyPartTexture(part)
		if not (part and part.Parent) then return end
		local orig = modState.origPartCache[part]
		if not orig then
			orig = {
				Material = part.Material,
				Color = part.Color,
				CastShadow = part.CastShadow,
			}
			modState.origPartCache[part] = orig
		end

		local targetMat = orig.Material
		local targetColor = orig.Color
		local targetShadow = modState.removeShadows and false or orig.CastShadow
		local usedMc = false

		if modState.snowTextures then
			if part.Anchored and not modState.ignoreNames[part.Name] then
				targetMat = modState.matSnow
				targetColor = Color3.fromRGB(255, 255, 255)
			end
		elseif modState.whiteBricks then
			targetMat = modState.matBrick
			targetColor = Color3.fromRGB(255, 255, 255)
		elseif modState.minecraftTexture then
			local mcId = modState.mcTextureIds[orig.Material]
			if mcId then
				targetMat = modState.matSmoothPlastic
				usedMc = true
				local texList = modState.mcTexCache[part]
				if not texList then
					texList = {}
					for i = 1, 6 do
						local tex = Instance.new("Texture")
						tex.Name = "McTexture_" .. modState.faceNames[i]
						tex.ZIndex = 2147483647
						tex.Face = modState.normalIds[i]
						tex.StudsPerTileU = 4
						tex.StudsPerTileV = 4
						tex.Parent = part
						texList[i] = tex
					end
					modState.mcTexCache[part] = texList
				end
				local fullTex = "rbxassetid://" .. mcId
				local col2 = orig.Color
				local transp = part.Transparency
				for i = 1, 6 do
					local tInst = texList[i]
					if tInst and tInst.Parent then
						if tInst.Texture ~= fullTex then tInst.Texture = fullTex end
						if tInst.Color3 ~= col2 then tInst.Color3 = col2 end
						if tInst.Transparency ~= transp then tInst.Transparency = transp end
					end
				end
			end
		end

		if not usedMc then
			local texList = modState.mcTexCache[part]
			if texList then
				for i = 1, 6 do
					if texList[i] then texList[i]:Destroy() end
				end
				modState.mcTexCache[part] = nil
			end
		end

		if part.Material ~= targetMat then part.Material = targetMat end
		if part.Color ~= targetColor then part.Color = targetColor end
		if part.CastShadow ~= targetShadow then part.CastShadow = targetShadow end
	end

	local function applyLightShadow(light)
		if not (light and light.Parent) then return end
		local orig = modState.origLightCache[light]
		if not orig then
			orig = {Shadows = light.Shadows}
			modState.origLightCache[light] = orig
		end
		local targetShadows = modState.removeShadows and false or orig.Shadows
		if light.Shadows ~= targetShadows then
			light.Shadows = targetShadows
		end
	end

	local function enqueueDescendant(desc)
		modState.queueWriteIdx = modState.queueWriteIdx + 1
		modState.queueBuffer[modState.queueWriteIdx] = desc
	end

	task.spawn(function()
		while true do
			if modState.queueReadIdx <= modState.queueWriteIdx then
				local t0 = os.clock()
				while modState.queueReadIdx <= modState.queueWriteIdx do
					local item = modState.queueBuffer[modState.queueReadIdx]
					modState.queueBuffer[modState.queueReadIdx] = nil
					modState.queueReadIdx = modState.queueReadIdx + 1
					if item and item.Parent then
						local cls = item.ClassName
						if cls == "Part" or cls == "MeshPart" or cls == "WedgePart" or cls == "CornerWedgePart" then
							if not isCharacterDescendant(item) then
								table.insert(modState.partsList, item)
								applyPartTexture(item)
							end
						elseif cls == "PointLight" or cls == "SpotLight" or cls == "SurfaceLight" then
							table.insert(modState.lightsList, item)
							applyLightShadow(item)
						end
						if modState.fpsBoosterActive then
							modState.fpsExtraHook(item)
						end
					end
					if os.clock() - t0 > 0.002 then break end
				end
			end
			task.wait()
		end
	end)

	local function syncTextureConnections()
