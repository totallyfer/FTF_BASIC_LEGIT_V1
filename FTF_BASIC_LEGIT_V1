	local function scanDescendantsYield(root, fn)
		local t0 = os.clock()
		local rIdx, wIdx = 1, 1
		local queue = {root}
		while rIdx <= wIdx do
			local cur = queue[rIdx]
			queue[rIdx] = nil
			rIdx = rIdx + 1
			if cur then
				local ch = cur:GetChildren()
				for TCzXeuAB = 1, #ch do
					wIdx = wIdx + 1
					queue[wIdx] = ch[TCzXeuAB]
					fn(ch[TCzXeuAB])
				end
			end
			if os.clock() - t0 > 0.003 then
				task.wait()
				t0 = os.clock()
			end
		end
	end

