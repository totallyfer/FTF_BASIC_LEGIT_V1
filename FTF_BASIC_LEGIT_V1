local createdTexturesStore = {}
createCardSubButton(texturesCard, "minecraftTexture", 102, function(enabled)
    if enabled then
        createdTexturesStore = {}
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and not isPlayerCharacter(part) then
                for _, mat in ipairs(minecraftMaterials) do
                    if part.Material.Name == mat[1] then
                        createdTexturesStore[part] = {mat = part.Material, addedTexts = {}}
                        for _, face in ipairs(faces) do
                            local tex = Instance.new("Texture")
                            tex.Texture = mat[2]
                            tex.Face = Enum.NormalId[face]
                            tex.Color3 = part.Color
                            tex.Transparency = part.Transparency
                            tex.Parent = part
                            table.insert(createdTexturesStore[part].addedTexts, tex)
                        end
                        part.Material = Enum.Material.SmoothPlastic
                        break
                    end
                end
            end
        end
    else
        for part, data in pairs(createdTexturesStore) do
            if part and part.Parent then
                part.Material = data.mat
                for _, tex in ipairs(data.addedTexts) do if tex and tex.Parent then tex:Destroy() end end
            end
        end
        createdTexturesStore = {}
    end
end)

local modifiedTextures = {}
createCardSubButton(texturesCard, "removeTexture", 136, function(enabled)
    if enabled then
        modifiedTextures = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if not isPlayerCharacter(obj) then
                if obj:IsA("Texture") or obj:IsA("Decal") then
                    table.insert(modifiedTextures, {item = obj, prop = "Transparency", val = obj.Transparency})
                    obj.Transparency = 1
                elseif obj:IsA("BasePart") then
                    if obj.Material ~= Enum.Material.SmoothPlastic and obj.Material ~= Enum.Material.Neon then
                        table.insert(modifiedTextures, {item = obj, prop = "Material", val = obj.Material})
                        obj.Material = Enum.Material.SmoothPlastic
                    end
                end
            end
        end
    else
        for _, data in ipairs(modifiedTextures) do
            if data.item and data.item.Parent then data.item[data.prop] = data.val end
        end
        modifiedTextures = {}
    end
end)

