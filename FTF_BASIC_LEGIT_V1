function CardClass:Slider(o)
	local isFog = (self.Page and self.Page.Key == "fog")
	local right = (o.style == "right")
	local row = self:_row(right and 68 or (isFog and 82 or 74))
	local min, max = o.min or 0, o.max or 100
	local dec = o.decimals or 0
	local suffix = o.suffix or ""
	local yLbl = right and 4 or (isFog and 8 or 6)

	local lbl = new("TextLabel", {
		Position = UDim2.new(0, 0, 0, yLbl), Size = UDim2.new(1, -60, 0, 28), TextSize = isFog and 16.5 or 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valLbl
	if right then
		valLbl = new("TextLabel", {
			Position = UDim2.new(0, 0, 0, yLbl), Size = UDim2.new(1, 0, 0, 28), TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)
	end

	local track = new("Frame", {
		Position = UDim2.new(0, 0, 0, right and 38 or (isFog and 48 or 42)), Size = UDim2.new(1, 0, 0, isFog and 11 or 9),
		BackgroundColor3 = C.track,
	}, row)
	corner(track, 5)
	local fill = new("Frame", {BackgroundColor3 = C.white, Size = UDim2.new(0, 0, 1, 0)}, track)
	corner(fill, 5)
	local knob
	if o.knob then
		knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.fromRGB(205, 205, 205), ZIndex = 2,
		}, track)
		corner(knob, 4)
	end
	local hit = new("TextButton", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, -14), Size = UDim2.new(1, 0, 1, 28), ZIndex = 3,
	}, track)

	local obj = {Kind = "slider", Value = o.default or min}
	local function fmt(v) return string.format("%." .. dec .. "f", v) end
	local function refresh()
		local a = (max == min) and 0 or (obj.Value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		if knob then knob.Position = UDim2.new(a, 0, 0.5, 0) end
		if right then
			lbl.Text = UI.tr(o.text)
			valLbl.Text = fmt(obj.Value) .. suffix
		else
			lbl.Text = UI.tr(o.text) .. ": " .. fmt(obj.Value) .. suffix
		end
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		v = math.clamp(tonumber(v) or min, min, max)
		if o.step then v = math.floor(v / o.step + 0.5) * o.step end
		local m = 10 ^ dec
		v = math.floor(v * m + 0.5) / m
		if self.Value == v then return end
		self.Value = v
		refresh()
		if not silent and o.callback then UI.safe(o.callback, v) end
	end
	refresh()

	local scroller = self.Column
	hit.InputBegan:Connect(function(inp)
		if isPointer(inp, false) then
			local function fromX(x)
				local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				obj:Set(min + a * (max - min))
			end
			fromX(inp.Position.X)
			UI.BeginDrag(fromX, scroller)
		end
	end)
	UI.OnLang(refresh)
	self:_reg(row, lbl)
	if o.id then UI.Registry[o.id] = obj end
	return obj
end

function CardClass:Dropdown(o)
	local options = {}
	for i, v in ipairs(o.options) do
		if type(v) == "table" then options[i] = {name = v[1], value = v[2]}
		else options[i] = {name = tostring(v), value = v} end
	end
	self.n = self.n + 1
	local holder = new("Frame", {
		Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self.n,
	}, self.Items)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, holder)

	local head = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1}, holder)
	local lbl = new("TextLabel", {Size = UDim2.new(1, -26, 1, 0), TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left}, head)
	local arrow = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(20, 44),
		Text = "▼", TextSize = 12, TextColor3 = C.sub,
	}, head)
	new("Frame", {BackgroundColor3 = C.line, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1)}, head)

	local ROW_H = 36
	local list = new("ScrollingFrame", {
		BackgroundColor3 = Color3.fromRGB(14, 14, 14),
		Size = UDim2.new(1, 0, 0, math.min(#options * ROW_H, o.maxHeight or 180)),
		CanvasSize = UDim2.new(0, 0, 0, #options * ROW_H), ScrollBarThickness = 2,
		ScrollBarImageColor3 = C.sub, Visible = false, LayoutOrder = 2,
	}, holder)
	corner(list, 6)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)

	local obj = {Kind = "dropdown", Index = nil, Value = nil, Data = nil}
	local btns = {}
	local function refresh()
		if obj.Index then
			local nm = UI.tr(options[obj.Index].name)
			lbl.Text = o.text and (UI.tr(o.text) .. ": " .. nm) or nm
		else
			lbl.Text = UI.tr(o.placeholder or o.text or "Select")
		end
		for i, b in ipairs(btns) do
			b.Text = UI.tr(options[i].name)
			b.TextColor3 = (i == obj.Index) and C.white or C.tabOff
		end
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		local idx
		if type(v) == "number" then idx = v
		else
			for i, op in ipairs(options) do
				if op.name == v then idx = i break end
			end
		end
		if not idx or not options[idx] then return end
		self.Index = idx
		self.Value = options[idx].name
		self.Data = options[idx].value
		refresh()
		list.Visible = false
		arrow.Text = "▼"
		if not silent and o.callback then UI.safe(o.callback, options[idx].name, options[idx].value) end
	end

	for i, op in ipairs(options) do
		local b = new("TextButton", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ROW_H), LayoutOrder = i,
			TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.tabOff, Text = UI.tr(op.name),
		}, list)
		new("UIPadding", {PaddingLeft = UDim.new(0, 12)}, b)
		b.Activated:Connect(function() obj:Set(i) end)
		btns[i] = b
	end
	head.Activated:Connect(function()
		list.Visible = not list.Visible
		arrow.Text = list.Visible and "▲" or "▼"
	end)
	if o.default then obj:Set(o.default, true) else refresh() end
	UI.OnLang(refresh)
	self:_reg(holder, lbl)
	if o.id then UI.Registry[o.id] = obj end
	return obj
end

