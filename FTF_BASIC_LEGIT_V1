    optBtn.TextColor3 = Color3.fromRGB(190, 190, 215)
    optBtn.TextSize = 12
    optBtn.TextXAlignment = Enum.TextXAlignment.Left

    optBtn.MouseButton1Click:Connect(function()
        currentSelectedIconId = badge.Icon
        selectIconBtn.Text = "  Select icon: " .. badge.Name .. " ▼"
        iconOptionsList.Visible = false
    end)
end

selectIconBtn.MouseButton1Click:Connect(function()
