	local function canStripTexture(inst)
		local mdl = inst:FindFirstAncestorOfClass("Model")
		if mdl and mdl:FindFirstChildOfClass("Humanoid") then
			return false
		end
		local cls = inst.ClassName
		return cls ~= "Camera" and not inst:IsA("GuiObject") and cls ~= "Highlight"
	end

	local function stripSingleTexture(inst)
		if not (inst and inst.Parent and canStripTexture(inst)) then return end
		local cls = inst.ClassName
		if cls == "Decal" or cls == "Texture" then
			if not modState.removedTexCache[inst] then
				modState.removedTexCache[inst] = {Texture = inst.Texture}
			end
			inst.Texture = ""
		elseif cls == "MeshPart" then
			if not modState.removedTexCache[inst] then
				modState.removedTexCache[inst] = {TextureID = inst.TextureID, Material = inst.Material}
			end
			inst.TextureID = ""
			inst.Material = modState.matSmoothPlastic
		elseif cls == "SpecialMesh" then
			if not modState.removedTexCache[inst] then
				modState.removedTexCache[inst] = {TextureId = inst.TextureId}
			end
			inst.TextureId = ""
		elseif inst:IsA("BasePart") then
			if not modState.removedTexCache[inst] then
				modState.removedTexCache[inst] = {Material = inst.Material}
			end
			inst.Material = modState.matSmoothPlastic
		end
	end

	local function restoreAllRemovedTextures()
		for inst, saved in pairs(modState.removedTexCache) do
			if inst and inst.Parent then
				local cls = inst.ClassName
				if cls == "Decal" or cls == "Texture" then
					if saved.Texture then inst.Texture = saved.Texture end
				elseif cls == "MeshPart" then
					if saved.TextureID then inst.TextureID = saved.TextureID end
					if saved.Material then inst.Material = saved.Material end
				elseif cls == "SpecialMesh" then
					if saved.TextureId then inst.TextureId = saved.TextureId end
				elseif inst:IsA("BasePart") and saved.Material then
					inst.Material = saved.Material
				end
			end
		end
		table.clear(modState.removedTexCache)
	end

