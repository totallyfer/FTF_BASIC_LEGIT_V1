		if not on then
			for _, item in ipairs(beastConns) do
				if typeof(item) == "RBXScriptConnection" then item:Disconnect()
				elseif typeof(item) == "thread" then task.cancel(item) end
			end
			table.clear(beastConns)
			for _, conn in pairs(beastMutedSounds) do
				if conn then conn:Disconnect() end
			end
			table.clear(beastMutedSounds)
			for s, vol in pairs(beastOrigVol) do
				if s and s.Parent then pcall(function() s.Volume = vol end) end
			end
			table.clear(beastOrigVol)
