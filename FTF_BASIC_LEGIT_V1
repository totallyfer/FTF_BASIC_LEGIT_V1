local currentLang = "EN"
local registeredElements = {}
local tabButtons = {}
local tabPages = {}
local activePage = nil

local function createTabPage(tabNameKey, defaultText, iconAssetId)
    local page = Instance.new("ScrollingFrame")
    page.Name = tabNameKey .. "Page"
    page.Parent = ContentContainer
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.CanvasSize = UDim2.new(0, 0, 4.5, 0)
    page.ScrollBarThickness = 3
    page.Visible = false

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 10)

    local sideBtn = Instance.new("TextButton")
    sideBtn.Parent = Sidebar
    sideBtn.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    sideBtn.BackgroundTransparency = 0.6
    sideBtn.BorderSizePixel = 0
    sideBtn.Size = UDim2.new(1, -8, 0, 38)
    sideBtn.Position = UDim2.new(0, 4, 0, 0)
    sideBtn.Font = Enum.Font.GothamSemibold
    sideBtn.Text = defaultText
    sideBtn.TextColor3 = Color3.fromRGB(170, 170, 195)
    sideBtn.TextSize = 12
    sideBtn.TextXAlignment = Enum.TextXAlignment.Left

    local sidePadding = Instance.new("UIPadding")
    sidePadding.Parent = sideBtn
    sidePadding.PaddingLeft = UDim.new(0, 36)

    local sideCorner = Instance.new("UICorner")
    sideCorner.CornerRadius = UDim.new(0, 10)
    sideCorner.Parent = sideBtn

    local sideStroke = Instance.new("UIStroke")
    sideStroke.Parent = sideBtn
    sideStroke.Transparency = 1
    sideStroke.Color = Color3.fromRGB(60, 130, 255)

    local sideIcon = Instance.new("ImageLabel")
    sideIcon.Parent = sideBtn
    sideIcon.BackgroundTransparency = 1
    sideIcon.Position = UDim2.new(0, -22, 0.5, -9)
    sideIcon.Size = UDim2.new(0, 18, 0, 18)
    sideIcon.Image = "rbxassetid://" .. tostring(iconAssetId)
    sideIcon.ScaleType = Enum.ScaleType.Fit

    table.insert(registeredElements, {
        type = "sidebar", 
        btn = sideBtn, 
        key = tabNameKey,
        updateText = function(txt)
            sideBtn.Text = txt
        end
    })

    sideBtn.MouseButton1Click:Connect(function()
        if activePage == page then
            page.Visible = false
            sideBtn.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
            sideBtn.TextColor3 = Color3.fromRGB(170, 170, 195)
            sideStroke.Transparency = 1
            activePage = nil
        else
            if activePage then
                activePage.Visible = false
            end
            for _, b in pairs(tabButtons) do
                b.btn.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
                b.btn.TextColor3 = Color3.fromRGB(170, 170, 195)
                b.stroke.Transparency = 1
            end
            page.Visible = true
            sideBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 180)
