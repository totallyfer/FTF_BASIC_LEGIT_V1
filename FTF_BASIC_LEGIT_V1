	-- Gray Characters
	local grayActive = false
	local grayPlayerConns = {}
	local grayCharData = setmetatable({}, {__mode = "k"})

	local function grayifyCharacter(char)
		if not (char and char.Parent and grayActive) then return end
		if grayCharData[char] then return end

		local record = {
			Parts = {},
			Accessories = {},
			Clothes = {},
			Connections = {},
		}

		local function grayifyDesc(desc)
			if not (desc and desc.Parent and grayActive) then return end
			local cls = desc.ClassName
			local isBodyOrPart = desc:IsA("BasePart") or (cls == "MeshPart" and desc.Name ~= "HumanoidRootPart")

			if isBodyOrPart then
				if desc:FindFirstAncestorOfClass("Accessory") then
					if desc.Name == "Handle" and not record.Accessories[desc] then
						local accInfo = {
							Color = desc.Color,
							Material = desc.Material,
							TextureID = nil,
							MeshInstance = nil,
						}
						desc.Color = Color3.fromRGB(150, 150, 150)
						desc.Material = modState.matSmoothPlastic

						if cls == "MeshPart" then
							accInfo.TextureID = desc.TextureID
							desc.TextureID = ""
						else
							local sm = desc:FindFirstChildWhichIsA("SpecialMesh") or desc:FindFirstChildWhichIsA("Mesh")
							if sm then
								accInfo.TextureID = sm.TextureId
								accInfo.MeshInstance = sm
								sm.TextureId = ""
							end
						end
						record.Accessories[desc] = accInfo
					end
				elseif not record.Parts[desc] then
					record.Parts[desc] = {
						Color = desc.Color,
						Material = desc.Material,
					}
					desc.Color = Color3.fromRGB(150, 150, 150)
					desc.Material = modState.matSmoothPlastic
				end
				return
			end

			if desc:IsA("Clothing") or cls == "ShirtGraphic" or desc.Name == "Shirt Graphic" then
				if not record.Clothes[desc] then
					record.Clothes[desc] = desc.Parent
					task.defer(function()
						if desc and desc.Parent and grayActive then
							desc.Parent = nil
						end
					end)
				end
				return
			end

			if cls == "SpecialMesh" or desc:IsA("FileMesh") then
				local parent = desc.Parent
				if parent and parent.Name == "Handle" and record.Accessories[parent] then
					local accInfo = record.Accessories[parent]
					if not accInfo.MeshInstance then
						accInfo.TextureID = desc.TextureId
						accInfo.MeshInstance = desc
						desc.TextureId = ""
					end
				end
			end
		end

		for _, d in ipairs(char:GetDescendants()) do
			grayifyDesc(d)
		end

		local addConn = char.DescendantAdded:Connect(function(d)
			task.wait()
			if grayActive then grayifyDesc(d) end
		end)
		table.insert(record.Connections, addConn)
		grayCharData[char] = record
	end

	local function restoreCharacterGray(char)
		local record = grayCharData[char]
		if not record then return end

		for _, c in ipairs(record.Connections) do
			pcall(function() c:Disconnect() end)
		end

		for part, info in pairs(record.Parts) do
			if part and part.Parent then
				pcall(function()
					part.Color = info.Color
					part.Material = info.Material
				end)
			end
		end

		for handle, info in pairs(record.Accessories) do
			if handle and handle.Parent then
				pcall(function()
					handle.Color = info.Color
					handle.Material = info.Material
					if handle:IsA("MeshPart") then
						handle.TextureID = info.TextureID or ""
					elseif info.MeshInstance and info.MeshInstance.Parent then
						info.MeshInstance.TextureId = info.TextureID or ""
					end
				end)
			end
		end

		for cloth, origParent in pairs(record.Clothes) do
			if cloth then
				pcall(function() cloth.Parent = origParent or char end)
			end
		end

		grayCharData[char] = nil
	end

	local function scheduleGrayChar(char)
		if not char or not grayActive then return end
		local plr = Players:GetPlayerFromCharacter(char)
		if plr and not plr:HasAppearanceLoaded() then
			local loaded = false
			local appConn = plr.CharacterAppearanceLoaded:Connect(function()
				loaded = true
			end)
			local tStart = os.clock()
			while not loaded and (os.clock() - tStart < 5) and grayActive do
				task.wait(0.1)
			end
			appConn:Disconnect()
			task.wait(0.1)
		else
			task.wait(0.1)
		end
		if grayActive and char.Parent then
			grayifyCharacter(char)
		end
	end

	fpsCard:Toggle({
		id = "tex_gray_characters",
		text = "Gray Characters",
		default = false,
		callback = function(on)
			grayActive = on
			if not on then
				for _, c in ipairs(grayPlayerConns) do
					pcall(function() c:Disconnect() end)
				end
				table.clear(grayPlayerConns)

				for char in pairs(grayCharData) do
					restoreCharacterGray(char)
