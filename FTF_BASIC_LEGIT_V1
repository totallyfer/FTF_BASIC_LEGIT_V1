	local function applyDarkAtmosphereFps()
		local atm = modState.lightingRef:FindFirstChildOfClass("Atmosphere")
		if not atm then
			atm = Instance.new("Atmosphere")
			local e = getFpsEntry(atm)
			if e.Created == nil then e.Created = true end
			atm.Parent = modState.lightingRef
		end
		local e = getFpsEntry(atm)
		if e.Color == nil then e.Color = atm.Color end
		if e.Glare == nil then e.Glare = atm.Glare end
		if e.Haze == nil then e.Haze = atm.Haze end
		if e.Decay == nil then e.Decay = atm.Decay end
		if e.Density == nil then e.Density = atm.Density end
		if e.Offset == nil then e.Offset = atm.Offset end

		atm.Color = Color3.fromRGB(0, 0, 0)
		atm.Glare = 0
		atm.Haze = 2.46
		atm.Decay = Color3.fromRGB(0, 0, 0)
		atm.Density = 0.75
		atm.Offset = 0
	end

	modState.fpsExtraHook = function(inst)
		if not modState.fpsBoosterActive then return end
		if inst:IsDescendantOf(Players) then return end
		if isOtherPlayerDesc(inst) or isLocalPlayerDesc(inst) then return end
		if inst:IsA("BackpackItem") or inst:FindFirstAncestorWhichIsA("BackpackItem") then return end

		local cls = inst.ClassName
		if cls == "Part" or cls == "WedgePart" or cls == "CornerWedgePart" or cls == "TrussPart" then
			local e = getFpsEntry(inst)
			if e.Material == nil then e.Material = inst.Material end
			if e.Reflectance == nil then e.Reflectance = inst.Reflectance end
			inst.Material = modState.matPlastic
			inst.Reflectance = 0
		elseif cls == "MeshPart" then
			local e = getFpsEntry(inst)
			if e.Material == nil then e.Material = inst.Material end
			if e.Reflectance == nil then e.Reflectance = inst.Reflectance end
			inst.Material = modState.matPlastic
			inst.Reflectance = 0
		elseif cls == "Decal" or cls == "Texture" then
			local e = getFpsEntry(inst)
			if e.Transparency == nil then e.Transparency = inst.Transparency end
			inst.Transparency = 1
		elseif fpsParticleClasses[cls] then
			local e = getFpsEntry(inst)
			if e.Enabled == nil then e.Enabled = inst.Enabled end
			inst.Enabled = false
		elseif inst:IsA("PostEffect") then
			local e = getFpsEntry(inst)
			if e.Enabled == nil then e.Enabled = inst.Enabled end
			inst.Enabled = false
		elseif cls == "Explosion" then
			local e = getFpsEntry(inst)
			if e.BlastPressure == nil then e.BlastPressure = inst.BlastPressure end
			if e.BlastRadius == nil then e.BlastRadius = inst.BlastRadius end
			inst.BlastPressure = 1
			inst.BlastRadius = 1
		elseif cls == "Clothing" or cls == "SurfaceAppearance" or cls == "BaseWrap" then
			inst:Destroy()
		elseif cls == "Model" then
			local e = getFpsEntry(inst)
			if e.LevelOfDetail == nil then e.LevelOfDetail = inst.LevelOfDetail end
			inst.LevelOfDetail = Enum.ModelLevelOfDetail.StreamingMesh
		end
	end

