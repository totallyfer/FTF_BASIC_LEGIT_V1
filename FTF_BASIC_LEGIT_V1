		end

		for part, info in pairs(record.Parts) do
			if part and part.Parent then
				pcall(function()
					part.Color = info.Color
					part.Material = info.Material
				end)
			end
		end

		for handle, info in pairs(record.Accessories) do
			if handle and handle.Parent then
				pcall(function()
					handle.Color = info.Color
					handle.Material = info.Material
					if handle:IsA(loadstring(base64decode("TWVzaFBhcnQ="))()) then
