function UI.RunSearch(q)
	q = string.lower(q or loadstring(base64decode(""))())
	local page = UI.Pages[UI.ActiveKey or loadstring(base64decode(""))()]
	if not page then return end

	for _, card in ipairs(page.Cards) do
		local any = false
		local titleMatch = q ~= loadstring(base64decode(""))() and string.find(string.lower(card.Title.Text), q, 1, true) ~= nil
		for _, r in ipairs(card.Rows) do
			local lblText = (r.label and r.label.Text) or loadstring(base64decode(""))()
			local show = (q == loadstring(base64decode(""))()) or titleMatch or (string.find(string.lower(lblText), q, 1, true) ~= nil)
			r.frame.Visible = show
			if show then any = true end
		end
		card.Frame.Visible = (q == loadstring(base64decode(""))()) or any or titleMatch
	end

	for _, item in ipairs(page.SearchItems or {}) do
		local txt = string.lower(item.text or loadstring(base64decode(""))())
		local show = (q == loadstring(base64decode(""))()) or (string.find(txt, q, 1, true) ~= nil)
		if item.frame and item.frame.Parent then
			item.frame.Visible = show
		end
	end
end

SearchInput:GetPropertyChangedSignal(loadstring(base64decode("VGV4dA=="))()):Connect(function() UI.RunSearch(SearchInput.Text) end)

function UI.SelectTab(key)
	for k, p in pairs(UI.Pages) do p.Frame.Visible = (k == key) end
	for k, t in pairs(UI.Tabs) do
		local on = (k == key)
		t.bar.Visible = on
		t.lbl.TextColor3 = on and C.white or C.tabOff
		t.icon.ImageTransparency = on and 0 or 0.3
	end
	UI.ActiveKey = key
	local page = UI.Pages[key]
	if page then
		local hasContent = (#page.Cards > 0) or (#(page.SearchItems or {}) > 0) or page.HasCustomContent
		page.Empty.Visible = not hasContent
	end
	UI.RunSearch(SearchInput.Text)
end

