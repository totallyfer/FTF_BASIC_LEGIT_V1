			return copy
		end
		return v
	end

	local function deserializeValue(v)
		if type(v) ~= loadstring(base64decode("dGFibGU="))() then return v end
		if v.__type == loadstring(base64decode("Q29sb3Iz"))() then
			return Color3.new(v.r or 0, v.g or 0, v.b or 0)
		elseif v.__type == loadstring(base64decode("VmVjdG9yMw=="))() then
