	local function triggerPcError(all)
		local curMap = ReplicatedStorage:FindFirstChild("CurrentMap")
		curMap = curMap and curMap.Value
		if not curMap then return end
		if all then
			for _, ch in ipairs(curMap:GetChildren()) do
				if ch.Name == "ComputerTable" then
