function UI.Card(pageKey, side, title)
	local page = UI.Pages[pageKey]
	if not page then error("Aba inexistente: " .. tostring(pageKey)) end
	side = side or "left"

	local parent
	if side == "full" then
		page.PendingHalf = nil
		page.Order = page.Order + 1
		local frame, titleLbl, items = buildCard(page.Main, title, pageKey)
		frame.LayoutOrder = page.Order
		local card = setmetatable({Frame = frame, Items = items, Page = page, Column = page.Main, Title = titleLbl, Rows = {}, n = 0}, CardClass)
		table.insert(page.Cards, card)
		UI.OnLang(function() titleLbl.Text = UI.tr(title) end)
		return card
	end

	if side == "right" then
		if page.PendingHalf then
			local pending = page.PendingHalf
			page.PendingHalf = nil
			parent = pending.RightSlot
		else
			local row = newHalfRow(page)
			parent = row.RightSlot
		end
	else
		local row = newHalfRow(page)
		parent = row.LeftSlot
		page.PendingHalf = row
	end

	local frame, titleLbl, items = buildCard(parent, title, pageKey)
	local card = setmetatable({Frame = frame, Items = items, Page = page, Column = page.Main, Title = titleLbl, Rows = {}, n = 0}, CardClass)
	table.insert(page.Cards, card)
	UI.OnLang(function() titleLbl.Text = UI.tr(title) end)
	return card
end

