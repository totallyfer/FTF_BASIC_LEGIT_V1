	-- Remove Particles
	local remParticlesActive = false
	local remParticlesWsConn = nil
	local remParticlesLightConn = nil
	local remParticlesCache = setmetatable({}, {__mode = "k"})

	local function handleParticleTarget(inst)
		if not remParticlesActive or not (inst and inst.Parent) then return end
		local cls = inst.ClassName
		local isEffect = (
			cls == "ParticleEmitter"
			or cls == "Sparkles"
			or cls == "Fire"
			or cls == "Smoke"
			or cls == "Trail"
			or cls == "Beam"
			or inst:IsA("PostEffect")
		)

		if not isEffect then
			if cls == "Explosion" then
				pcall(function() inst:Destroy() end)
			end
			return
		end

		if remParticlesCache[inst] then
			inst.Enabled = false
			return
		end

		local propConn = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
			if remParticlesActive and inst.Enabled == true then
				inst.Enabled = false
			end
		end)
