		else
			local ct = curMap:FindFirstChild("ComputerTable")
			local scr = ct and ct:FindFirstChild("Screen")
			local errS = scr and scr:FindFirstChild("ErrorSound")
			if errS then errS:Play() end
		end
	end

	local function triggerSiren()
		local curMap = ReplicatedStorage:FindFirstChild("CurrentMap")
		curMap = curMap and curMap.Value
		local siren = curMap and curMap:FindFirstChild("FacilitySiren")
		local exitS = siren and siren:FindFirstChild("SoundExitsUnlock")
		if exitS then exitS:Play() end
	end

	task.spawn(function()
		while true do
			task.wait(0.08)
			local anySpam = false
			for _, nm in ipairs(spamNames) do
				if spamState[nm] then
					anySpam = true
					local s = spamSoundRefs[nm]
					if s and (s.TimePosition >= s.TimeLength * 0.5 or not s.IsPlaying) then
						s:Play()
					end
				end
			end
			if spamState.ErrorAll then anySpam = true triggerPcError(true) end
			if spamState.ErrorOne then anySpam = true triggerPcError(false) end
			if spamState.Siren then anySpam = true triggerSiren() task.wait(0.2) end
			if not anySpam then task.wait(0.25) end
		end
	end)

	local volCard = UI.Card("sounds", "left", "Volume Settings")
	volCard:Toggle({
		text = "Enable Volume Modifier",
		callback = function(on) volEnabled = on refreshAllPhysics() end
	})
