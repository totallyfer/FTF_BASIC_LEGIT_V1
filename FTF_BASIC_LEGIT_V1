do
	local soundsPage = UI.Pages["sounds"]
	local soundsCol = soundsPage.Main
	local UserConfigs = {}

	local muteState = {
		MuteSteps = false,
		MuteJumps = false,
	}

	local customIds = {
		Running = UserConfigs.CustomSound_Walk or "0",
		Jumping = UserConfigs.CustomSound_Jump or "0",
		Landing = UserConfigs.CustomSound_Fall or "0",
	}

	local savedCharSounds = setmetatable({}, {__mode = "k"})
	local volEnabled = false
	local volFootsteps = 10
	local volJump = 10
	local volFall = 10

	local distEnabled = false
	local distFootsteps = 10
	local distJump = 10
	local distFall = 10

	local spamState = {}
	local muteBeastActive = false
	local beastConns = {}
	local beastMutedSounds = {}
	local beastOrigVol = {}

	local function registerSearch(frame, text)
		table.insert(soundsPage.SearchItems, {frame = frame, text = text or ""})
	end

	local function toAssetId(v)
		if type(v) == "number" and v > 0 then
			return "rbxassetid://" .. tostring(v)
		elseif type(v) == "string" and v ~= "" and v ~= "0" then
			if string.find(v, "rbxassetid://", 1, true) then return v end
			return "rbxassetid://" .. v
		end
		return nil
	end

	local function applyCustomSoundsToChar(char)
		if not char then return end
		task.spawn(function()
			local hrp = char:WaitForChild("HumanoidRootPart", 10)
			if not hrp then return end
			task.wait(0.35)

			if not savedCharSounds[char] then
				savedCharSounds[char] = {}
				for k in pairs(customIds) do
					local s = hrp:FindFirstChild(k)
					if s and s:IsA("Sound") then
						savedCharSounds[char][k] = s.SoundId
					end
				end
			end

			for k, val in pairs(customIds) do
				local s = hrp:FindFirstChild(k)
				if val == 0 or val == "0" then
					if s and s:IsA("Sound") and savedCharSounds[char][k] then
						s.SoundId = savedCharSounds[char][k]
					end
				else
					local aid = toAssetId(val)
					if aid then
						if s and s:IsA("Sound") then
							s.SoundId = aid
						else
							local ns = Instance.new("Sound")
							ns.Name = k
							ns.SoundId = aid
							ns.Parent = hrp
						end
					end
				end
			end
		end)
	end

	local function refreshAllCustomSounds()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then applyCustomSoundsToChar(plr.Character) end
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then applyCustomSoundsToChar(plr.Character) end
		plr.CharacterAdded:Connect(applyCustomSoundsToChar)
	end
	Players.PlayerAdded:Connect(function(plr)
		if plr.Character then applyCustomSoundsToChar(plr.Character) end
		plr.CharacterAdded:Connect(applyCustomSoundsToChar)
	end)

	local trackedSounds = setmetatable({}, {__mode = "k"})
	local soundCategory = setmetatable({}, {__mode = "k"})
	local baseVol = setmetatable({}, {__mode = "k"})
	local baseDist = setmetatable({}, {__mode = "k"})
	local defaultVols = {Footsteps = 0.65, Jump = 0.5, Fall = 0.5}
	local defaultDists = {Footsteps = 60, Jump = 80, Fall = 80}

	local function classifySound(s)
		local n = string.lower(s.Name)
		if string.find(n, "running", 1, true) or string.find(n, "walk", 1, true) or string.find(n, "step", 1, true) then
			return "Footsteps"
		elseif string.find(n, "jumping", 1, true) or string.find(n, "jump", 1, true) then
			return "Jump"
		elseif string.find(n, "landing", 1, true) or string.find(n, "fall", 1, true) or string.find(n, "land", 1, true) then
			return "Fall"
		end
		return nil
	end

	local function updateSoundPhysics(s)
		local cat = soundCategory[s]
		if not cat then return end

		local vBase = baseVol[s] or defaultVols[cat] or 0.5
		local dBase = baseDist[s] or defaultDists[cat] or 80

		local vMult = 1
		if volEnabled then
			if cat == "Footsteps" then vMult = volFootsteps / 10
			elseif cat == "Jump" then vMult = volJump / 10
			elseif cat == "Fall" then vMult = volFall / 10 end
		end

		local dMult = 1
		if distEnabled then
			if cat == "Footsteps" then dMult = distFootsteps / 10
			elseif cat == "Jump" then dMult = distJump / 10
			elseif cat == "Fall" then dMult = distFall / 10 end
		end

		local localChar = LocalPlayer.Character
		if localChar and s:IsDescendantOf(localChar) then
			if cat == "Footsteps" and muteState.MuteSteps then vMult = 0 end
			if (cat == "Jump" or cat == "Fall") and muteState.MuteJumps then vMult = 0 end
		end

		pcall(function()
			s.Volume = vBase * vMult
			s.RollOffMaxDistance = dBase * dMult
		end)
	end

	local function refreshAllPhysics()
		for s in pairs(trackedSounds) do
			if s and s.Parent then updateSoundPhysics(s) end
		end
	end

	local function hookSound(d)
		if not d:IsA("Sound") then return end
		trackedSounds[d] = true
		if not baseVol[d] then baseVol[d] = d.Volume end
		if not baseDist[d] then baseDist[d] = d.RollOffMaxDistance end
		local cat = classifySound(d)
		if cat then
			soundCategory[d] = cat
			updateSoundPhysics(d)
			d:GetPropertyChangedSignal("Volume"):Connect(function() updateSoundPhysics(d) end)
			d:GetPropertyChangedSignal("RollOffMaxDistance"):Connect(function() updateSoundPhysics(d) end)
		end
	end

	for _, d in ipairs(workspace:GetDescendants()) do hookSound(d) end
	workspace.DescendantAdded:Connect(hookSound)

	local hackConns = {}
	local hackKeywords = {"keyboard", "typing", "type", "hack", "key"}
	local function isHackSound(s)
		local n = string.lower(s.Name)
		for _, kw in ipairs(hackKeywords) do
			if string.find(n, kw, 1, true) then return true end
		end
		return false
	end
	local function isOnComputerTable(inst)
		local p = inst.Parent
		while p do
			if p.Name == "ComputerTable" then return true end
			p = p.Parent
		end
		return false
	end
	local function muteHackSound(s)
		s.Volume = 0
		table.insert(hackConns, {
			Sig = s:GetPropertyChangedSignal("Volume"):Connect(function() s.Volume = 0 end),
			Obj = s
		})
	end

	local hitMuteEnabled = false
	local hitConns = {}
	local hitKeywords = {"hit", "smack", "damage", "crack", "bone", "bash", "punch", "impact"}
	local function isHitSound(name)
		local n = string.lower(name)
		for _, kw in ipairs(hitKeywords) do
			if string.match(n, kw) then return true end
		end
		return false
	end
	local function muteHitSound(inst)
		if inst:IsA("Sound") and isHitSound(inst.Name) then
			inst.Volume = 0
			table.insert(hitConns, {
				Sig = inst:GetPropertyChangedSignal("Volume"):Connect(function()
					if hitMuteEnabled and inst.Volume > 0 then inst.Volume = 0 end
				end),
				Obj = inst
			})
		end
	end

	local beastItems = {"Hammer", "Gemstone Hammer", "Iron Hammer", "Mallet"}
	local beastSoundNames = {action = true, warning = true, heartbeat = true, terror = true}
	local function isBeastPlayer(plr)
		if plr.Team and plr.Team.Name == "Beast" then return true end
		if plr.Character then
			for _, n in ipairs(beastItems) do
				if plr.Character:FindFirstChild(n) then return true end
			end
		end
		local bp = plr:FindFirstChild("Backpack")
		if bp then
			for _, n in ipairs(beastItems) do
				if bp:FindFirstChild(n) then return true end
			end
		end
		return false
	end
	local function forceMuteBeastSound(s)
		if not muteBeastActive or not s:IsA("Sound") or beastMutedSounds[s] then return end
		beastOrigVol[s] = s.Volume
		s.Volume = 0
		beastMutedSounds[s] = s:GetPropertyChangedSignal("Volume"):Connect(function()
			if muteBeastActive and s.Volume > 0 then s.Volume = 0 end
		end)
	end
	local function checkBeastCandidate(d)
		if muteBeastActive and d:IsA("Sound") and beastSoundNames[string.lower(d.Name)] then
