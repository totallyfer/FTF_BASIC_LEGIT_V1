local function attachAutoGrid(row, frame, inner, grid, cellSz, gapSz, padV)
	local function getItemCount()
		local n = 0
		for _, ch in ipairs(inner:GetChildren()) do
			if ch:IsA(loadstring(base64decode("R3VpT2JqZWN0"))()) and ch.Visible then
				n = n + 1
			end
		end
		return n
	end

	local function refreshBox()
		local availW = math.max(inner.AbsoluteSize.X - 16, cellSz)
		local cols = math.max(1, math.floor((availW + gapSz) / (cellSz + gapSz)))
		local rows = math.max(1, math.ceil(getItemCount() / cols))
		local calcH = rows * cellSz + math.max(0, rows - 1) * gapSz
		local h = math.max(grid.AbsoluteContentSize.Y, calcH) + padV * 2 + 4
		inner.Size = UDim2.new(1, 0, 0, h)
		frame.Size = UDim2.new(1, 0, 0, h)
		row.Size = UDim2.new(1, 0, 0, h + 6)
	end

	grid:GetPropertyChangedSignal(loadstring(base64decode("QWJzb2x1dGVDb250ZW50U2l6ZQ=="))()):Connect(refreshBox)
	inner:GetPropertyChangedSignal(loadstring(base64decode("QWJzb2x1dGVTaXpl"))()):Connect(refreshBox)
	inner.ChildAdded:Connect(function() task.defer(refreshBox) end)
