local function updateLanguageUI()
    local t = translations[currentLang]
    if not t then return end
    for _, item in ipairs(registeredElements) do
        if item.type == "sidebar" then
            if item.updateText then
                item.updateText(t[item.key] or item.key)
            else
                item.btn.Text = t[item.key] or item.key
            end
        elseif item.type == "subbutton" then
            local currentStatusText = item.btn:FindFirstChildOfClass("TextLabel").Text
            item.btn.Text = "  " .. (t[item.key] or item.key)
            local ind = item.btn:FindFirstChildOfClass("TextLabel")
            if ind then
                ind.Parent = nil
                ind.Parent = item.btn
            end
        elseif item.type == "slider_label" then
            item.btn.Text = "  " .. (t[item.key] or item.key) .. ": " .. item.getValue() .. item.suffix
        elseif item.type == "info_title" then
            item.btn.Text = t.infoTitle
        elseif item.type == "close_info" then
            item.btn.Text = t.close
        elseif item.type == "icon_desc" then
            item.btn.Text = t.iconDesc
        elseif item.type == "select_bg_title" then
            item.btn.Text = t.selectBgTitle
        elseif item.type == "select_bg_btn" then
            local currentText = item.btn.Text
            if currentText:find("▼") then
                item.btn.Text = t.selectBgBtn
            else
                item.btn.Text = t.selectBgBtn:gsub("▼", "▲")
            end
        elseif item.type == "outros_title" then
            item.btn.Text = t.outrosPulos
        elseif item.type == "avatar_label_1" then
            item.btn.Text = t.targetPlayerTitle
        elseif item.type == "avatar_label_2" then
            item.btn.Text = t.skinInputTitle
        elseif item.type == "avatar_btn" then
            item.btn.Text = t.applyAvatarBtn
        end
    end
end

