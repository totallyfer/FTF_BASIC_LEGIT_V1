local originalSounds = {}
local activePassosSound = nil
local activePulosSound = nil
local activeSoundButtons = {}

local function applySoundsToCharacter(character)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    local runSound = hrp:WaitForChild("Running", 5)
    local jumpSound = hrp:WaitForChild("Jumping", 5)

    if not originalSounds[character] then
        originalSounds[character] = {
            Running = runSound and runSound.SoundId or "",
            Jumping = jumpSound and jumpSound.SoundId or ""
        }
    end

    if runSound then 
        runSound.SoundId = activePassosSound or originalSounds[character].Running 
    end
    if jumpSound then 
        jumpSound.SoundId = activePulosSound or originalSounds[character].Jumping 
    end
end

local function monitorPlayer(player)
    player.CharacterAdded:Connect(function(char)
        task.spawn(function()
            applySoundsToCharacter(char)
        end)
    end)
    if player.Character then
        task.spawn(function()
            applySoundsToCharacter(player.Character)
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    monitorPlayer(p)
end
Players.PlayerAdded:Connect(monitorPlayer)

local function updateAllCharactersSounds()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            applySoundsToCharacter(p.Character)
        end
    end
end

