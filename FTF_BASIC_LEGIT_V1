	local obj = {Kind = "grid", Value = nil, Cells = {}}
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		local found
		for _, c in ipairs(self.Cells) do
			local on = (c.item.name == v)
			c.stroke.Transparency = on and 0 or 1
			if on then found = c.item end
		end
		self.Value = found and found.name or nil
		if found and not silent and o.callback then UI.safe(o.callback, found) end
	end

	for i, it in ipairs(o.items) do
		local b = new("ImageButton", {
			BackgroundColor3 = Color3.fromRGB(20, 20, 20), Image = it.image or "",
			ScaleType = Enum.ScaleType.Fit, LayoutOrder = i,
		}, grid)
		corner(b, 8)
		local st = stroke(b, C.white, 1.5, 1)
		if not it.image or it.image == "" then
			local t = new("TextLabel", {Size = UDim2.fromScale(1, 1), TextSize = 14, Text = UI.tr(it.name)}, b)
			UI.OnLang(function() t.Text = UI.tr(it.name) end)
		end
		table.insert(obj.Cells, {item = it, stroke = st})
		b.Activated:Connect(function() obj:Set(it.name) end)
	end
	if o.default then obj:Set(o.default, true) end
	if o.id then UI.Registry[o.id] = obj end
	return obj
end

