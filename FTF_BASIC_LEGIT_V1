	local function handleParticleTarget(inst)
		if not remParticlesActive or not (inst and inst.Parent) then return end
		local cls = inst.ClassName
		local isEffect = (
			cls == loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))()
			or cls == loadstring(base64decode("U3BhcmtsZXM="))()
			or cls == loadstring(base64decode("RmlyZQ=="))()
			or cls == loadstring(base64decode("U21va2U="))()
			or cls == loadstring(base64decode("VHJhaWw="))()
			or cls == loadstring(base64decode("QmVhbQ=="))()
			or inst:IsA(loadstring(base64decode("UG9zdEVmZmVjdA=="))())
		)

		if not isEffect then
			if cls == loadstring(base64decode("RXhwbG9zaW9u"))() then
				pcall(function() inst:Destroy() end)
			end
			return
		end

		if remParticlesCache[inst] then
			inst.Enabled = false
			return
		end

		local propConn = inst:GetPropertyChangedSignal(loadstring(base64decode("RW5hYmxlZA=="))()):Connect(function()
			if remParticlesActive and inst.Enabled == true then
				inst.Enabled = false
			end
		end)
		remParticlesCache[inst] = {
			Enabled = inst.Enabled,
			Conn = propConn,
		}
		inst.Enabled = false
	end

