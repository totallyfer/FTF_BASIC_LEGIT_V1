local function new(class, props, parent)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then
		o.BorderSizePixel = 0
		if o:IsA("TextLabel") or o:IsA("ImageLabel") then o.BackgroundTransparency = 1 end
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			o.Text = ""
			o.Font = Enum.Font.Gotham
			o.TextColor3 = C.text
			o.TextSize = 16
		end
		if o:IsA("GuiButton") then o.AutoButtonColor = false end
	end
	if props then
		for k, v in pairs(props) do o[k] = v end
	end
	if parent then o.Parent = parent end
	return o
end

local function corner(o, r)
	return new("UICorner", {CornerRadius = UDim.new(0, r)}, o)
end

local function stroke(o, color, thick, trans)
	return new("UIStroke", {
		Color = color, Thickness = thick or 1, Transparency = trans or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	}, o)
end

local function isPointer(inp, moving)
	local t = inp.UserInputType
	if moving then
		return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
	end
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

