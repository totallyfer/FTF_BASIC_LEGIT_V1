	local spamNames = {"WarningSound", "SeenSound", "SafeSound", "DetectedSound", "CorrectSound"}
	local spamSoundRefs = {}
	for _, nm in ipairs(spamNames) do
		spamSoundRefs[nm] = SoundService:FindFirstChild(nm)
