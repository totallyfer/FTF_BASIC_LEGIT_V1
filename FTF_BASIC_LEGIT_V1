	local function applyDoubleJumpTex(modeVal)
		modState.userConfigs.TexturesPage_DoubleJump = modeVal
		for _, c in ipairs(djConns) do c:Disconnect() end
		table.clear(djConns)

		local function processEffect(inst)
			local cls = inst.ClassName
			if modeVal == loadstring(base64decode("RGVmYXVsdA=="))() then
				inst:SetAttribute(loadstring(base64decode("Q3VycmVudFRleHR1cmU="))(), nil)
				if cls == loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))() then
					if origEmitterTex[inst] then inst.Texture = origEmitterTex[inst] end
				elseif cls == loadstring(base64decode("U3BhcmtsZXM="))() then
					local clone = inst.Parent and inst.Parent:FindFirstChild(loadstring(base64decode("Q3VzdG9tU3BhcmtsZUNsb25lXw=="))() .. inst.Name)
					if clone then clone:Destroy() end
					inst.SparkleColor = origSparkleCol[inst] or Color3.new(1, 1, 1)
				end
				return
			end

			if inst:GetAttribute(loadstring(base64decode("Q3VycmVudFRleHR1cmU="))()) == modeVal then return end
			inst:SetAttribute(loadstring(base64decode("Q3VycmVudFRleHR1cmU="))(), modeVal)

			if cls == loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))() then
				local okTex, texStr = pcall(function() return inst.Texture end)
				if okTex and texStr and string.find(string.lower(texStr), loadstring(base64decode("c3BhcmtsZXNfbWFpbg=="))(), 1, true) then
					if not origEmitterTex[inst] then
						origEmitterTex[inst] = texStr
					end
					inst.Texture = modeVal
				end
			elseif cls == loadstring(base64decode("U3BhcmtsZXM="))() then
				if not origSparkleCol[inst] then
					origSparkleCol[inst] = inst.SparkleColor
				end
				inst.SparkleColor = Color3.new(0, 0, 0)
				local oldClone = inst.Parent and inst.Parent:FindFirstChild(loadstring(base64decode("Q3VzdG9tU3BhcmtsZUNsb25lXw=="))() .. inst.Name)
				if oldClone then oldClone:Destroy() end

				local pe = Instance.new(loadstring(base64decode("UGFydGljbGVFbWl0dGVy"))())
				pe.Name = loadstring(base64decode("Q3VzdG9tU3BhcmtsZUNsb25lXw=="))() .. inst.Name
				pe.Texture = modeVal
				pe.Rate = 20
				pe.Speed = NumberRange.new(2, 4)
				pe.Lifetime = NumberRange.new(1.5, 2)
				pe.Rotation = NumberRange.new(0, 360)
				pe.RotSpeed = NumberRange.new(-50, 50)
				pe.LightEmission = 0.8
				pe.ZOffset = 1
				pe.Brightness = 2
				pe.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(0.5, 1),
					NumberSequenceKeypoint.new(1, 0),
				})
				pe.Parent = inst.Parent
				pe.Enabled = inst.Enabled

				local c1 = inst:GetPropertyChangedSignal(loadstring(base64decode("RW5hYmxlZA=="))()):Connect(function()
					if pe and pe.Parent then pe.Enabled = inst.Enabled end
				end)
				local c2 = inst.Destroying:Connect(function()
					if c1 then c1:Disconnect() end
					if pe and pe.Parent then pe:Destroy() end
				end)
				table.insert(djConns, c1)
