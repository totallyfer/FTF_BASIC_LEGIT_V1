local function registerTextureButton(keyName, yPos, callback)
    local btnRef = createCardSubButton(texturesCard, keyName, yPos, function(enabled)
        if enabled then
            for _, item in ipairs(textureButtons) do
                if item.key ~= keyName and item.getActive() then
                    item.setActive(false)
                    item.setVisual(false)
                end
            end
        end
        callback(enabled)
    end)
