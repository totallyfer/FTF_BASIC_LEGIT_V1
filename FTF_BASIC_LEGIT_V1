--[[ =====================================================
   ABA SONS (VOLUME, DISTÂNCIA, MUTE, SPAM, MUSIC & PACKS)
   ===================================================== ]]

do
	local soundsPage = UI.Pages[loadstring(base64decode("c291bmRz"))()]
	local soundsCol = soundsPage.Main
	local UserConfigs = {}

	local muteState = {
		MuteSteps = false,
		MuteJumps = false,
	}

	local customIds = {
		Running = UserConfigs.CustomSound_Walk or loadstring(base64decode("MA=="))(),
		Jumping = UserConfigs.CustomSound_Jump or loadstring(base64decode("MA=="))(),
		Landing = UserConfigs.CustomSound_Fall or loadstring(base64decode("MA=="))(),
	}

	local savedCharSounds = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
	local volEnabled = false
	local volFootsteps = 10
	local volJump = 10
	local volFall = 10

	local distEnabled = false
	local distFootsteps = 10
	local distJump = 10
	local distFall = 10

	local spamState = {}
	local muteBeastActive = false
	local beastConns = {}
	local beastMutedSounds = {}
	local beastOrigVol = {}

	local function registerSearch(frame, text)
		table.insert(soundsPage.SearchItems, {frame = frame, text = text or loadstring(base64decode(""))()})
	end

	local function toAssetId(v)
		if type(v) == loadstring(base64decode("bnVtYmVy"))() and v > 0 then
			return loadstring(base64decode("cmJ4YXNzZXRpZDovLw=="))() .. tostring(v)
		elseif type(v) == loadstring(base64decode("c3RyaW5n"))() and v ~= loadstring(base64decode(""))() and v ~= loadstring(base64decode("MA=="))() then
			if string.find(v, loadstring(base64decode("cmJ4YXNzZXRpZDovLw=="))(), 1, true) then return v end
			return loadstring(base64decode("cmJ4YXNzZXRpZDovLw=="))() .. v
		end
		return nil
	end

	local function applyCustomSoundsToChar(char)
		if not char then return end
		task.spawn(function()
			local hrp = char:WaitForChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))(), 10)
			if not hrp then return end
			task.wait(0.35)

			if not savedCharSounds[char] then
				savedCharSounds[char] = {}
				for k in pairs(customIds) do
					local s = hrp:FindFirstChild(k)
					if s and s:IsA(loadstring(base64decode("U291bmQ="))()) then
						savedCharSounds[char][k] = s.SoundId
					end
				end
			end

			for k, val in pairs(customIds) do
				local s = hrp:FindFirstChild(k)
				if val == 0 or val == loadstring(base64decode("MA=="))() then
					if s and s:IsA(loadstring(base64decode("U291bmQ="))()) and savedCharSounds[char][k] then
						s.SoundId = savedCharSounds[char][k]
					end
				else
					local aid = toAssetId(val)
					if aid then
						if s and s:IsA(loadstring(base64decode("U291bmQ="))()) then
							s.SoundId = aid
						else
							local ns = Instance.new(loadstring(base64decode("U291bmQ="))())
							ns.Name = k
							ns.SoundId = aid
							ns.Parent = hrp
						end
					end
				end
			end
		end)
	end

	local function refreshAllCustomSounds()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then applyCustomSoundsToChar(plr.Character) end
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then applyCustomSoundsToChar(plr.Character) end
		plr.CharacterAdded:Connect(applyCustomSoundsToChar)
	end
	Players.PlayerAdded:Connect(function(plr)
		if plr.Character then applyCustomSoundsToChar(plr.Character) end
		plr.CharacterAdded:Connect(applyCustomSoundsToChar)
	end)

	local trackedSounds = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
	local soundCategory = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
	local baseVol = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
	local baseDist = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
	local defaultVols = {Footsteps = 0.65, Jump = 0.5, Fall = 0.5}
	local defaultDists = {Footsteps = 60, Jump = 80, Fall = 80}

	local function classifySound(s)
		local n = string.lower(s.Name)
		if string.find(n, loadstring(base64decode("cnVubmluZw=="))(), 1, true) or string.find(n, loadstring(base64decode("d2Fsaw=="))(), 1, true) or string.find(n, loadstring(base64decode("c3RlcA=="))(), 1, true) then
			return loadstring(base64decode("Rm9vdHN0ZXBz"))()
		elseif string.find(n, loadstring(base64decode("anVtcGluZw=="))(), 1, true) or string.find(n, loadstring(base64decode("anVtcA=="))(), 1, true) then
			return loadstring(base64decode("SnVtcA=="))()
		elseif string.find(n, loadstring(base64decode("bGFuZGluZw=="))(), 1, true) or string.find(n, loadstring(base64decode("ZmFsbA=="))(), 1, true) or string.find(n, loadstring(base64decode("bGFuZA=="))(), 1, true) then
			return loadstring(base64decode("RmFsbA=="))()
		end
		return nil
	end

	local function updateSoundPhysics(s)
		local cat = soundCategory[s]
		if not cat then return end

		local vBase = baseVol[s] or defaultVols[cat] or 0.5
		local dBase = baseDist[s] or defaultDists[cat] or 80

		local vMult = 1
		if volEnabled then
			if cat == loadstring(base64decode("Rm9vdHN0ZXBz"))() then vMult = volFootsteps / 10
			elseif cat == loadstring(base64decode("SnVtcA=="))() then vMult = volJump / 10
			elseif cat == loadstring(base64decode("RmFsbA=="))() then vMult = volFall / 10 end
		end

		local dMult = 1
		if distEnabled then
			if cat == loadstring(base64decode("Rm9vdHN0ZXBz"))() then dMult = distFootsteps / 10
			elseif cat == loadstring(base64decode("SnVtcA=="))() then dMult = distJump / 10
			elseif cat == loadstring(base64decode("RmFsbA=="))() then dMult = distFall / 10 end
		end

		local localChar = LocalPlayer.Character
		if localChar and s:IsDescendantOf(localChar) then
			if cat == loadstring(base64decode("Rm9vdHN0ZXBz"))() and muteState.MuteSteps then vMult = 0 end
			if (cat == loadstring(base64decode("SnVtcA=="))() or cat == loadstring(base64decode("RmFsbA=="))()) and muteState.MuteJumps then vMult = 0 end
		end

		pcall(function()
			s.Volume = vBase * vMult
			s.RollOffMaxDistance = dBase * dMult
		end)
	end

	local function refreshAllPhysics()
		for s in pairs(trackedSounds) do
			if s and s.Parent then updateSoundPhysics(s) end
		end
	end

	local function hookSound(d)
		if not d:IsA(loadstring(base64decode("U291bmQ="))()) then return end
		trackedSounds[d] = true
		if not baseVol[d] then baseVol[d] = d.Volume end
		if not baseDist[d] then baseDist[d] = d.RollOffMaxDistance end
		local cat = classifySound(d)
		if cat then
			soundCategory[d] = cat
			updateSoundPhysics(d)
			d:GetPropertyChangedSignal(loadstring(base64decode("Vm9sdW1l"))()):Connect(function() updateSoundPhysics(d) end)
			d:GetPropertyChangedSignal(loadstring(base64decode("Um9sbE9mZk1heERpc3RhbmNl"))()):Connect(function() updateSoundPhysics(d) end)
		end
	end

	for _, d in ipairs(workspace:GetDescendants()) do hookSound(d) end
	workspace.DescendantAdded:Connect(hookSound)

	local hackConns = {}
	local hackKeywords = {loadstring(base64decode("a2V5Ym9hcmQ="))(), loadstring(base64decode("dHlwaW5n"))(), loadstring(base64decode("dHlwZQ=="))(), loadstring(base64decode("aGFjaw=="))(), loadstring(base64decode("a2V5"))()}
	local function isHackSound(s)
		local n = string.lower(s.Name)
		for _, kw in ipairs(hackKeywords) do
			if string.find(n, kw, 1, true) then return true end
		end
		return false
	end
	local function isOnComputerTable(inst)
		local p = inst.Parent
		while p do
			if p.Name == loadstring(base64decode("Q29tcHV0ZXJUYWJsZQ=="))() then return true end
			p = p.Parent
		end
		return false
	end
	local function muteHackSound(s)
		s.Volume = 0
		table.insert(hackConns, {
			Sig = s:GetPropertyChangedSignal(loadstring(base64decode("Vm9sdW1l"))()):Connect(function() s.Volume = 0 end),
			Obj = s
		})
	end

	local hitMuteEnabled = false
	local hitConns = {}
	local hitKeywords = {loadstring(base64decode("aGl0"))(), loadstring(base64decode("c21hY2s="))(), loadstring(base64decode("ZGFtYWdl"))(), loadstring(base64decode("Y3JhY2s="))(), loadstring(base64decode("Ym9uZQ=="))(), loadstring(base64decode("YmFzaA=="))(), loadstring(base64decode("cHVuY2g="))(), loadstring(base64decode("aW1wYWN0"))()}
	local function isHitSound(name)
		local n = string.lower(name)
		for _, kw in ipairs(hitKeywords) do
			if string.match(n, kw) then return true end
		end
		return false
	end
	local function muteHitSound(inst)
		if inst:IsA(loadstring(base64decode("U291bmQ="))()) and isHitSound(inst.Name) then
			inst.Volume = 0
			table.insert(hitConns, {
				Sig = inst:GetPropertyChangedSignal(loadstring(base64decode("Vm9sdW1l"))()):Connect(function()
					if hitMuteEnabled and inst.Volume > 0 then inst.Volume = 0 end
				end),
				Obj = inst
			})
		end
	end

	local beastItems = {loadstring(base64decode("SGFtbWVy"))(), loadstring(base64decode("R2Vtc3RvbmUgSGFtbWVy"))(), loadstring(base64decode("SXJvbiBIYW1tZXI="))(), loadstring(base64decode("TWFsbGV0"))()}
	local beastSoundNames = {action = true, warning = true, heartbeat = true, terror = true}
	local function isBeastPlayer(plr)
		if plr.Team and plr.Team.Name == loadstring(base64decode("QmVhc3Q="))() then return true end
		if plr.Character then
			for _, n in ipairs(beastItems) do
				if plr.Character:FindFirstChild(n) then return true end
			end
		end
		local bp = plr:FindFirstChild(loadstring(base64decode("QmFja3BhY2s="))())
		if bp then
			for _, n in ipairs(beastItems) do
				if bp:FindFirstChild(n) then return true end
			end
		end
		return false
	end
	local function forceMuteBeastSound(s)
		if not muteBeastActive or not s:IsA(loadstring(base64decode("U291bmQ="))()) or beastMutedSounds[s] then return end
		beastOrigVol[s] = s.Volume
		s.Volume = 0
		beastMutedSounds[s] = s:GetPropertyChangedSignal(loadstring(base64decode("Vm9sdW1l"))()):Connect(function()
			if muteBeastActive and s.Volume > 0 then s.Volume = 0 end
		end)
	end
	local function checkBeastCandidate(d)
		if muteBeastActive and d:IsA(loadstring(base64decode("U291bmQ="))()) and beastSoundNames[string.lower(d.Name)] then
			forceMuteBeastSound(d)
		end
	end
	local function watchBeastChar(char)
		if not char or not muteBeastActive then return end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA(loadstring(base64decode("U291bmQ="))()) then forceMuteBeastSound(d) end
		end
		table.insert(beastConns, char.DescendantAdded:Connect(function(d)
			if muteBeastActive and d:IsA(loadstring(base64decode("U291bmQ="))()) then forceMuteBeastSound(d) end
		end))
	end
	local function setBeastMute(on)
		muteBeastActive = on
		if not on then
			for _, item in ipairs(beastConns) do
				if typeof(item) == loadstring(base64decode("UkJYU2NyaXB0Q29ubmVjdGlvbg=="))() then item:Disconnect()
				elseif typeof(item) == loadstring(base64decode("dGhyZWFk"))() then task.cancel(item) end
			end
			table.clear(beastConns)
			for _, conn in pairs(beastMutedSounds) do
				if conn then conn:Disconnect() end
			end
			table.clear(beastMutedSounds)
			for s, vol in pairs(beastOrigVol) do
				if s and s.Parent then pcall(function() s.Volume = vol end) end
			end
			table.clear(beastOrigVol)
			return
		end

		for _, d in ipairs(workspace:GetDescendants()) do checkBeastCandidate(d) end
		for _, d in ipairs(SoundService:GetDescendants()) do checkBeastCandidate(d) end
		table.insert(beastConns, workspace.DescendantAdded:Connect(checkBeastCandidate))
		table.insert(beastConns, SoundService.DescendantAdded:Connect(checkBeastCandidate))
		table.insert(beastConns, task.spawn(function()
			local watched = setmetatable({}, {__mode = loadstring(base64decode("aw=="))()})
			while muteBeastActive do
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr.Character and isBeastPlayer(plr) and not watched[plr] then
						watched[plr] = true
						watchBeastChar(plr.Character)
						table.insert(beastConns, plr.CharacterAdded:Connect(function(c)
							task.wait(0.3)
							watchBeastChar(c)
						end))
					end
				end
				task.wait(2.5)
			end
