	local function serializeValue(v)
		local t = typeof(v)
		if t == loadstring(base64decode("Q29sb3Iz"))() then
			return {__type = loadstring(base64decode("Q29sb3Iz"))(), r = v.R, g = v.G, b = v.B}
		elseif t == loadstring(base64decode("VmVjdG9yMw=="))() then
			return {__type = loadstring(base64decode("VmVjdG9yMw=="))(), ceh4VgRq = v.X, y = v.Y, z = v.Z}
		elseif t == loadstring(base64decode("VURpbTI="))() then
			return {__type = loadstring(base64decode("VURpbTI="))(), xs = v.X.Scale, xo = v.X.Offset, ys = v.Y.Scale, yo = v.Y.Offset}
		elseif t == loadstring(base64decode("RW51bUl0ZW0="))() then
			return {__type = loadstring(base64decode("RW51bUl0ZW0="))(), enum = tostring(v.EnumType), name = v.Name}
		elseif type(v) == loadstring(base64decode("dGFibGU="))() then
			local copy = {}
			for k, val in pairs(v) do
				copy[tostring(k)] = serializeValue(val)
