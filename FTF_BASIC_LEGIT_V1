function CardClass:Slider(o)
	local isFog = (self.Page and self.Page.Key == loadstring(base64decode("Zm9n"))())
	local right = (o.style == loadstring(base64decode("cmlnaHQ="))())
	local row = self:_row(right and 68 or (isFog and 82 or 74))
	local min, max = o.min or 0, o.max or 100
	local dec = o.decimals or 0
	local suffix = o.suffix or loadstring(base64decode(""))()
	local yLbl = right and 4 or (isFog and 8 or 6)

	local lbl = new(loadstring(base64decode("VGV4dExhYmVs"))(), {
		Position = UDim2.new(0, 0, 0, yLbl), Size = UDim2.new(1, -60, 0, 28), TextSize = isFog and 16.5 or 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valLbl
	if right then
		valLbl = new(loadstring(base64decode("VGV4dExhYmVs"))(), {
			Position = UDim2.new(0, 0, 0, yLbl), Size = UDim2.new(1, 0, 0, 28), TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)
	end

	local track = new(loadstring(base64decode("RnJhbWU="))(), {
		Position = UDim2.new(0, 0, 0, right and 38 or (isFog and 48 or 42)), Size = UDim2.new(1, 0, 0, isFog and 11 or 9),
		BackgroundColor3 = C.track,
	}, row)
	corner(track, 5)
	local fill = new(loadstring(base64decode("RnJhbWU="))(), {BackgroundColor3 = C.white, Size = UDim2.new(0, 0, 1, 0)}, track)
	corner(fill, 5)
	local knob
	if o.knob then
		knob = new(loadstring(base64decode("RnJhbWU="))(), {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.fromRGB(205, 205, 205), ZIndex = 2,
		}, track)
		corner(knob, 4)
	end
	local hit = new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))(), {
		BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, -14), Size = UDim2.new(1, 0, 1, 28), ZIndex = 3,
	}, track)

	local obj = {Kind = loadstring(base64decode("c2xpZGVy"))(), Value = o.default or min}
	local function fmt(v) return string.format(loadstring(base64decode("JS4="))() .. dec .. loadstring(base64decode("Zg=="))(), v) end
	local function refresh()
		local a = (max == min) and 0 or (obj.Value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		if knob then knob.Position = UDim2.new(a, 0, 0.5, 0) end
		if right then
			lbl.Text = UI.tr(o.text)
			valLbl.Text = fmt(obj.Value) .. suffix
		else
			lbl.Text = UI.tr(o.text) .. loadstring(base64decode("OiA="))() .. fmt(obj.Value) .. suffix
		end
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		v = math.clamp(tonumber(v) or min, min, max)
		if o.step then v = math.floor(v / o.step + 0.5) * o.step end
		local m = 10 ^ dec
		v = math.floor(v * m + 0.5) / m
		if self.Value == v then return end
		self.Value = v
		refresh()
		if not silent and o.callback then UI.safe(o.callback, v) end
	end
	refresh()

	local scroller = self.Column
	hit.InputBegan:Connect(function(inp)
		if isPointer(inp, false) then
			local function fromX(ceh4VgRq)
				local a = math.clamp((ceh4VgRq - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				obj:Set(min + a * (max - min))
			end
			fromX(inp.Position.X)
			UI.BeginDrag(fromX, scroller)
		end
	end)
	UI.OnLang(refresh)
	self:_reg(row, lbl)
	if o.id then UI.Registry[o.id] = obj end
	return obj
end

