local applyCustomBtn = Instance.new("TextButton")
applyCustomBtn.Parent = customCard
applyCustomBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 230)
applyCustomBtn.BorderSizePixel = 0
applyCustomBtn.Position = UDim2.new(0, 12, 0, 222)
applyCustomBtn.Size = UDim2.new(1, -24, 0, 38)
applyCustomBtn.Font = Enum.Font.GothamBold
applyCustomBtn.Text = "Apply"
applyCustomBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
applyCustomBtn.TextSize = 12

local applyCustomCorner = Instance.new("UICorner")
applyCustomCorner.CornerRadius = UDim.new(0, 8)
applyCustomCorner.Parent = applyCustomBtn

local activeSpoofName = "TotallyFer"
local activeSpoofLevel = 1265
local activeSpoofIcon = currentSelectedIconId
local customizationActive = false

RunService.PreRender:Connect(function()
    if not customizationActive then return end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local screenG = pGui:FindFirstChild("ScreenGui")
        if screenG then
            local namesFrame = screenG:FindFirstChild("PlayerNamesFrame")
            if namesFrame then
                local playerFrame = namesFrame:FindFirstChild(LocalPlayer.Name .. "PlayerFrame")
                if playerFrame then
                    local levelLabel = playerFrame:FindFirstChild("LevelLabel")
                    local nameLabel = playerFrame:FindFirstChild("NameLabel")
                    local iconLabel = playerFrame:FindFirstChild("IconLabel")

                    if levelLabel then levelLabel.Text = tostring(activeSpoofLevel) end
                    if nameLabel then nameLabel.Text = activeSpoofName end
                    if playerFrame then playerFrame.LayoutOrder = -activeSpoofLevel end
                    if iconLabel then iconLabel.Image = activeSpoofIcon end
                end
            end
        end
    end

    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayName = activeSpoofName end
    end
end)

applyCustomBtn.MouseButton1Click:Connect(function()
    local spoofName = inputNameBox.Text
    if spoofName == "" then spoofName = LocalPlayer.Name end
    
    local parsedLevel = tonumber(inputLevelBox.Text)
    local spoofLevel = parsedLevel or 1265
    local spoofIconId = currentSelectedIconId

    activeSpoofName = spoofName
    activeSpoofLevel = spoofLevel
    activeSpoofIcon = spoofIconId
    customizationActive = true

    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "CUSTOMIZATION", Text = "Name, Level and Icon successfully applied/updated!", Duration = 3
        })
    end)
end)
