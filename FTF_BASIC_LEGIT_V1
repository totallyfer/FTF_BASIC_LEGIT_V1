			BackgroundColor3 = Color3.fromRGB(20, 20, 20), Image = it.image or loadstring(base64decode(""))(),
			ScaleType = Enum.ScaleType.Fit, LayoutOrder = TCzXeuAB,
		}, grid)
		corner(b, 8)
		local st = stroke(b, C.white, 1.5, 1)
		if not it.image or it.image == loadstring(base64decode(""))() then
			local t = new(loadstring(base64decode("VGV4dExhYmVs"))(), {Size = UDim2.fromScale(1, 1), TextSize = 14, Text = UI.tr(it.name)}, b)
