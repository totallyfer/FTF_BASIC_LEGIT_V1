do
	local blackColor = Color3.new(0, 0, 0)
	local calibCard = UI.Card("fog", "left", "Color Calibrator")

	local calibState = {
		enabled = false, contrast = 0, brightness = 0,
		saturation = 0, hue = 0, opacity = 1
	}

	local function getCalibCC()
		local cc = Lighting:FindFirstChild("NexVoid_ColorCalibrator")
		if not cc then
			cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "NexVoid_ColorCalibrator"
			cc.Parent = Lighting
		end
		return cc
	end

	local function updateCalibrator()
		local cc = getCalibCC()
		cc.Enabled = calibState.enabled
		if not calibState.enabled then return end
		local op = math.clamp(calibState.opacity, 0, 1)
		cc.Brightness = calibState.brightness * op
		cc.Contrast = calibState.contrast * op
		cc.Saturation = calibState.saturation * op
		local h = (calibState.hue % 360 + 360) % 360 / 360
		local s = math.clamp(math.abs(calibState.hue) * 0.0027777777777778, 0, 1)
		local c32 = Color3.fromHSV(h, s, 1)
		cc.TintColor = Color3.new(1 + (c32.R - 1) * op, 1 + (c32.G - 1) * op, 1 + (c32.B - 1) * op)
	end

	calibCard:Toggle({id = "calib_enable", text = "Enable Calibrator", callback = function(on) calibState.enabled = on updateCalibrator() end})
	local slCon = calibCard:Slider({id = "calib_contrast", text = "Contrast", min = -100, max = 100, default = 0, callback = function(v) calibState.contrast = v / 100 updateCalibrator() end})
	local slBri = calibCard:Slider({id = "calib_brightness", text = "Brightness", min = -100, max = 100, default = 0, callback = function(v) calibState.brightness = v / 100 updateCalibrator() end})
	local slSat = calibCard:Slider({id = "calib_saturation", text = "Saturation", min = -100, max = 300, default = 0, callback = function(v) calibState.saturation = v / 100 updateCalibrator() end})
	local slHue = calibCard:Slider({id = "calib_hue", text = "Hue Filter", min = -180, max = 180, default = 0, callback = function(v) calibState.hue = v updateCalibrator() end})
	local slOpa = calibCard:Slider({id = "calib_opacity", text = "Filter Opacity", min = 0, max = 100, default = 100, suffix = "%", callback = function(v) calibState.opacity = v / 100 updateCalibrator() end})
	calibCard:Button({
		text = "Reset Calibrator",
		callback = function()
			slCon:Set(0) slBri:Set(0) slSat:Set(0) slHue:Set(0) slOpa:Set(100)
			UI.Notify("Color Calibrator Reset!", 2)
		end
	})

	local FogEngine = {
		noFog = false,
		blackFog = false,
		customFog = {
			enabled = false,
			color = Color3.fromRGB(128, 128, 128),
			power = 50,
		},
		savedAtm = setmetatable({}, {__mode = "k"}),
		savedSky = setmetatable({}, {__mode = "k"}),
		childConn = nil,
		blackFogBackup = nil,
		customFogBackup = nil,
	}

	local function ensureAtmosphere()
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if not atm then
			atm = Instance.new("Atmosphere")
			atm.Parent = Lighting
		end
		return atm
	end

	local function snapshotAtmosphere(atm)
		if atm and not FogEngine.savedAtm[atm] then
			FogEngine.savedAtm[atm] = {
				Color = atm.Color,
				Glare = atm.Glare,
				Haze = atm.Haze,
				Decay = atm.Decay,
				Density = atm.Density,
				Offset = atm.Offset,
			}
		end
	end

	local function restoreAtmosphere(atm)
		local snap = atm and FogEngine.savedAtm[atm]
		if snap and atm.Parent then
			atm.Color = snap.Color
			atm.Glare = snap.Glare
			atm.Haze = snap.Haze
			atm.Decay = snap.Decay
			atm.Density = snap.Density
			atm.Offset = snap.Offset
		end
	end

	local function applyNoFogAtm(atm)
		if not FogEngine.noFog or not atm then return end
		snapshotAtmosphere(atm)
		if atm.Color ~= blackColor then atm.Color = blackColor end
		if atm.Glare ~= 0 then atm.Glare = 0 end
		if atm.Haze ~= 10 then atm.Haze = 10 end
		if atm.Decay ~= blackColor then atm.Decay = blackColor end
		if atm.Density ~= 0 then atm.Density = 0 end
		if atm.Offset ~= 0 then atm.Offset = 0 end
		if Lighting.FogEnd ~= 999999 then Lighting.FogEnd = 999999 end

		if not atm:FindFirstChild("NoFogLock") then
			local lock = Instance.new("Folder")
			lock.Name = "NoFogLock"
			lock.Parent = atm
			atm:GetPropertyChangedSignal("Density"):Connect(function()
				if FogEngine.noFog and atm.Density ~= 0 then
					atm.Density = 0
				end
			end)
		end
	end

	local function applyNoFogSky(sky)
		if not FogEngine.noFog or not sky then return end
		if not FogEngine.savedSky[sky] then
			FogEngine.savedSky[sky] = {
				MoonAngularSize = sky.MoonAngularSize,
				StarCount = sky.StarCount,
			}
		end
		if sky.MoonAngularSize ~= 10 then sky.MoonAngularSize = 10 end
		if sky.StarCount ~= 0 then sky.StarCount = 0 end
	end

	local function applyCustomFogNow()
		if not FogEngine.customFog.enabled then return end
		pcall(function()
			local atm = ensureAtmosphere()
			snapshotAtmosphere(atm)
			local col = FogEngine.customFog.color
			local dens = FogEngine.customFog.power / 100
			local fogEnd = math.max(100, 100000 - FogEngine.customFog.power * 999)

			if atm.Color ~= col then atm.Color = col end
			if atm.Decay ~= col then atm.Decay = col end
			if atm.Glare ~= 0 then atm.Glare = 0 end
			if atm.Haze ~= 2.46 then atm.Haze = 2.46 end
			if atm.Density ~= dens then atm.Density = dens end
			if atm.Offset ~= 0 then atm.Offset = 0 end

			if Lighting.FogColor ~= col then Lighting.FogColor = col end
			if Lighting.FogEnd ~= fogEnd then Lighting.FogEnd = fogEnd end
		end)
	end

	local function applyBlackFogNow()
		if not FogEngine.blackFog or FogEngine.customFog.enabled then return end
		pcall(function()
			local atm = ensureAtmosphere()
			snapshotAtmosphere(atm)
			if atm.Color ~= blackColor then atm.Color = blackColor end
			if atm.Glare ~= 0 then atm.Glare = 0 end
			if atm.Haze ~= 2.46 then atm.Haze = 2.46 end
			if atm.Decay ~= blackColor then atm.Decay = blackColor end
			if atm.Density ~= 0.75 then atm.Density = 0.75 end
			if atm.Offset ~= 0 then atm.Offset = 0 end
		end)
	end

	local fogCard = UI.Card("fog", "right", "Fog Settings")

	fogCard:Toggle({
		id = "fog_nofog", text = "No fog",
		callback = function(on)
			FogEngine.noFog = on
			if on then
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				if atm then applyNoFogAtm(atm) end
				local sky = Lighting:FindFirstChildOfClass("Sky")
				if sky then applyNoFogSky(sky) end
				if FogEngine.childConn then FogEngine.childConn:Disconnect() end
				FogEngine.childConn = Lighting.ChildAdded:Connect(function(ch)
					task.defer(function()
						if ch:IsA("Atmosphere") then
							applyNoFogAtm(ch)
						elseif ch:IsA("Sky") then
							applyNoFogSky(ch)
						end
					end)
				end)
			else
				if FogEngine.childConn then
					FogEngine.childConn:Disconnect()
					FogEngine.childConn = nil
				end
				for atm in pairs(FogEngine.savedAtm) do
					restoreAtmosphere(atm)
				end
				for sky, d in pairs(FogEngine.savedSky) do
					if sky and sky.Parent then
						sky.MoonAngularSize = d.MoonAngularSize
						sky.StarCount = d.StarCount
					end
				end
				table.clear(FogEngine.savedAtm)
				table.clear(FogEngine.savedSky)
			end
		end
	})

	fogCard:Toggle({
		id = "fog_blackfog", text = "Black Fog",
		callback = function(on)
			FogEngine.blackFog = on
			if on then
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				FogEngine.blackFogBackup = atm and {
					Color = atm.Color, Glare = atm.Glare, Haze = atm.Haze,
					Decay = atm.Decay, Density = atm.Density, Offset = atm.Offset
				} or "None"
				applyBlackFogNow()
				task.spawn(function()
					while FogEngine.blackFog do
						applyBlackFogNow()
						task.wait(2)
					end
				end)
			else
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				if FogEngine.blackFogBackup == "None" then
					if atm then atm:Destroy() end
				elseif type(FogEngine.blackFogBackup) == "table" and atm then
					atm.Color = FogEngine.blackFogBackup.Color
					atm.Glare = FogEngine.blackFogBackup.Glare
					atm.Haze = FogEngine.blackFogBackup.Haze
					atm.Decay = FogEngine.blackFogBackup.Decay
					atm.Density = FogEngine.blackFogBackup.Density
					atm.Offset = FogEngine.blackFogBackup.Offset
				end
				FogEngine.blackFogBackup = nil
			end
		end
	})

	local origExposure = Lighting.ExposureCompensation
	local exposureConn = nil
	local targetExposure = 0
	fogCard:Slider({
		id = "fog_flashlight", text = "Flashlight Intensity", min = 0, max = 500, default = 0,
		callback = function(v)
			targetExposure = v / 100
			if exposureConn then exposureConn:Disconnect() exposureConn = nil end
			if v > 0 then
				pcall(function() Lighting.ExposureCompensation = targetExposure end)
				exposureConn = Lighting:GetPropertyChangedSignal("ExposureCompensation"):Connect(function()
					if Lighting.ExposureCompensation ~= targetExposure then
						pcall(function() Lighting.ExposureCompensation = targetExposure end)
					end
				end)
			else
				pcall(function() Lighting.ExposureCompensation = origExposure end)
			end
		end
	})
	fogCard:Spacer(8)

	local customFogCard = UI.Card("fog", "right", "Custom Fog")

	customFogCard:Toggle({
		id = "fog_custom_enable", text = "Enable Custom Fog",
		callback = function(on)
			FogEngine.customFog.enabled = on
			if on then
				local atm = Lighting:FindFirstChildOfClass("Atmosphere")
				FogEngine.customFogBackup = atm and {
					Color = atm.Color, Glare = atm.Glare, Haze = atm.Haze,
					Decay = atm.Decay, Density = atm.Density, Offset = atm.Offset,
					FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd
				} or {
					FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd, None = true
				}
				applyCustomFogNow()
				task.spawn(function()
					while FogEngine.customFog.enabled do
						applyCustomFogNow()
						task.wait(2)
					end
				end)
			elseif FogEngine.customFogBackup then
				pcall(function()
