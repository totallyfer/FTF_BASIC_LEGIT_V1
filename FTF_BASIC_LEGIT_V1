--[[ =====================================================
   ABA CONFIG (CONFIG MANAGER COM PREVIEW E EXPORTAÇÃO)
   ===================================================== ]]

do
	local configPage = UI.Pages["config"]
	local configCol = configPage.Main
	local CONFIG_FOLDER = "FTF_Basic_Configs"
	local configState = {
		selectedFile = nil,
		fileButtons = {},
		statusLabel = nil,
		nameInput = nil,
		refreshList = nil,
	}

	local function ensureConfigFolder()
		if type(isfolder) == "function" and type(makefolder) == "function" then
			pcall(function()
				if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
			end)
		end
	end

	local function getConfigFilePath(name)
		local clean = tostring(name or ""):gsub("[^%w%-%_]", "_")
		if clean == "" then return nil end
		return CONFIG_FOLDER .. "/" .. clean .. ".json"
	end

	local function getAllConfigFiles()
		local out = {}
		ensureConfigFolder()
		if type(listfiles) == "function" then
			pcall(function()
				for _, path in ipairs(listfiles(CONFIG_FOLDER)) do
					local fname = tostring(path):match("([^/\\]+)$") or tostring(path)
					if fname:sub(-5):lower() == ".json" then
						table.insert(out, fname:sub(1, -6))
					end
				end
			end)
		end
		table.sort(out)
		return out
	end

	local function serializeValue(v)
		local t = typeof(v)
		if t == "Color3" then
			return {__type = "Color3", r = v.R, g = v.G, b = v.B}
		elseif t == "Vector3" then
			return {__type = "Vector3", x = v.X, y = v.Y, z = v.Z}
		elseif t == "UDim2" then
			return {__type = "UDim2", xs = v.X.Scale, xo = v.X.Offset, ys = v.Y.Scale, yo = v.Y.Offset}
		elseif t == "EnumItem" then
			return {__type = "EnumItem", enum = tostring(v.EnumType), name = v.Name}
		elseif type(v) == "table" then
			local copy = {}
			for k, val in pairs(v) do
				copy[tostring(k)] = serializeValue(val)
			end
			return copy
		end
		return v
	end

	local function deserializeValue(v)
		if type(v) ~= "table" then return v end
		if v.__type == "Color3" then
			return Color3.new(v.r or 0, v.g or 0, v.b or 0)
		elseif v.__type == "Vector3" then
			return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
		elseif v.__type == "UDim2" then
			return UDim2.new(v.xs or 0, v.xo or 0, v.ys or 0, v.yo or 0)
		elseif v.__type == "EnumItem" then
			local enumObj = Enum[v.enum]
			return enumObj and enumObj[v.name] or v.name
		end
		local out = {}
		for k, val in pairs(v) do
			out[k] = deserializeValue(val)
		end
		return out
	end

	local function setStatus(msg, col)
		if configState.statusLabel then
			configState.statusLabel.Text = msg
			configState.statusLabel.TextColor3 = col or C.sub
		end
	end

	local function collectRegistryValues()
		local values = {}
		for id, ctrl in pairs(UI.Registry) do
			if ctrl and type(ctrl.Get) == "function" then
				local ok, val = pcall(function() return ctrl:Get() end)
				if ok and val ~= nil then
					values[id] = serializeValue(val)
				end
			end
		end
		return values
	end

	local function applyRegistryValues(values)
		if type(values) ~= "table" then return end
		for id, rawVal in pairs(values) do
			local ctrl = UI.Registry[id]
			if ctrl and type(ctrl.Set) == "function" then
				local decoded = deserializeValue(rawVal)
				pcall(function() ctrl:Set(decoded) end)
			end
		end
	end

	local function saveConfigByName(name)
		local clean = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if clean == "" then
			setStatus("Digite um nome para a config!", C.yellow)
			UI.Notify("Digite um nome para a config!", 3)
			return false
		end
		if type(writefile) ~= "function" then
			setStatus("Executor sem suporte a writefile!", C.red)
			UI.Notify("Executor não suporta salvar arquivos.", 3)
			return false
		end
		ensureConfigFolder()
		local path = getConfigFilePath(clean)
		if not path then
			setStatus("Nome de config inválido!", C.red)
			return false
		end

		local data = {
			name = clean,
			savedAt = os.date("%d/%m/%Y %H:%M:%S"),
			placeId = game.PlaceId,
			values = collectRegistryValues(),
		}
		local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
		if not ok or not encoded then
			setStatus("Erro ao codificar JSON!", C.red)
			return false
		end

		local wok = pcall(function() writefile(path, encoded) end)
		if not wok then
			setStatus("Falha ao escrever arquivo da config!", C.red)
			return false
		end

		configState.selectedFile = clean
		if configState.refreshList then configState.refreshList() end
		setStatus("Config '" .. clean .. "' salva!", C.green)
		UI.Notify("Config '" .. clean .. "' salva!", 3)
		return true
	end

	local function loadConfigByName(name)
		local target = name or configState.selectedFile
		if not target or target == "" then
			setStatus("Selecione uma config na lista!", C.yellow)
			UI.Notify("Selecione uma config primeiro!", 3)
			return false
		end
		if type(isfile) ~= "function" or type(readfile) ~= "function" then
			setStatus("Executor sem suporte a leitura de arquivos!", C.red)
			return false
		end
		local path = getConfigFilePath(target)
		if not path or not isfile(path) then
			setStatus("Arquivo de config não encontrado!", C.red)
			if configState.refreshList then configState.refreshList() end
			return false
		end

		local okRead, raw = pcall(function() return readfile(path) end)
		if not okRead or not raw then
			setStatus("Erro ao ler config!", C.red)
			return false
		end

		local okDec, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
		if not okDec or type(decoded) ~= "table" then
			setStatus("JSON da config corrompido!", C.red)
			return false
		end

		applyRegistryValues(decoded.values or decoded)
		configState.selectedFile = target
		if configState.nameInput then configState.nameInput:Set(target) end
		if configState.refreshList then configState.refreshList() end
		setStatus("Config '" .. target .. "' carregada!", C.green)
		UI.Notify("Config '" .. target .. "' aplicada!", 3)
		return true
	end

	local function deleteConfigByName(name)
		local target = name or configState.selectedFile
		if not target or target == "" then
			setStatus("Selecione uma config para excluir!", C.yellow)
			return false
		end
		if type(delfile) ~= "function" then
			setStatus("Executor sem suporte a delfile!", C.red)
			return false
		end
		local path = getConfigFilePath(target)
		if path and isfile(path) then
			pcall(function() delfile(path) end)
		end
		if configState.selectedFile == target then
			configState.selectedFile = nil
		end
		if configState.refreshList then configState.refreshList() end
		setStatus("Config '" .. target .. "' excluída!", C.sub)
		UI.Notify("Config '" .. target .. "' excluída!", 3)
		return true
	end

	local function refreshFileSelectionUI()
		for fname, btn in pairs(configState.fileButtons) do
			if btn and btn.Parent then
				local active = (fname == configState.selectedFile)
				btn.BackgroundColor3 = active and C.white or C.btn
				btn.TextColor3 = active and C.dark or C.text
			end
		end
	end

	local cfgCard = UI.Card("config", "full", "Config Manager")
	configState.nameInput = cfgCard:Input({
