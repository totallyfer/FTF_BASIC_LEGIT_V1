	stroke(delBtn, C.line, 1, 0.3)

	loadBtn.Activated:Connect(function() loadConfigByName(configState.selectedFile) end)
	delBtn.Activated:Connect(function() deleteConfigByName(configState.selectedFile) end)

	configState.statusLabel = cfgCard:Label({
		text = (type(listfiles) == "function") and "Pronto para salvar ou carregar configs." or "Aviso: executor sem suporte a listfiles/writefile.",
		size = 13,
		color = (type(listfiles) == "function") and C.sub or C.yellow,
		height = 24,
	}).Label

	local listCard = UI.Card("config", "full", "Saved Configs")
	local listHolder = listCard:Custom(0, nil, true)
	new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, listHolder)

	local emptyLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 36), TextSize = 14, TextColor3 = C.sub,
		Text = UI.tr("No configs saved"), Visible = true, LayoutOrder = 1,
	}, listHolder)
	UI.OnLang(function() emptyLbl.Text = UI.tr("No configs saved") end)

	configState.refreshList = function()
		table.clear(configState.fileButtons)
		for _, ch in ipairs(listHolder:GetChildren()) do
			if ch:IsA("TextButton") then ch:Destroy() end
		end
		local files = getAllConfigFiles()
		emptyLbl.Visible = (#files == 0)
		for idx, fname in ipairs(files) do
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 38), LayoutOrder = idx + 1,
				BackgroundColor3 = (fname == configState.selectedFile) and C.white or C.btn,
				TextColor3 = (fname == configState.selectedFile) and C.dark or C.text,
				TextSize = 14, Font = Enum.Font.GothamBold, Text = fname,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, listHolder)
			corner(b, 6)
			new("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12)}, b)
			configState.fileButtons[fname] = b
			b.Activated:Connect(function()
				configState.selectedFile = fname
				if configState.nameInput then configState.nameInput:Set(fname) end
				refreshFileSelectionUI()
				setStatus("Selecionado: " .. fname, C.text)
			end)
		end
	end

	configState.refreshList()
	local _ = configCol
end

UI.SelectTab("music")
